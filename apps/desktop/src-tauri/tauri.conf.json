{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bit",
  "version": "0.0.0",
  "identifier": "dev.hybrys.bit",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "pnpm --dir ../.. --filter @bit/ui dev"
  },
  "app": {
    "windows": [
      {
        "label": "companion",
        "title": "Bit",
        "width": 160,
        "height": 160,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": true,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "rpm"],
    "externalBin": ["binaries/bitd"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"]
  }
}
